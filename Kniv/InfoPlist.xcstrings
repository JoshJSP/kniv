{
  "sourceLanguage": "nl",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv"
          }
        }
      }
    },
    "CFBundleName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv checks your calendar to set a reminder at a free moment."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv takes photos of notes, whiteboards and receipts."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv opens locked trays with Face ID."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv shows your list at the supermarket, at school or at home, even when the app is closed."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv saves a place so it can remind you there."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv reads the barometer to show how many floors you've climbed."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv only listens while you dictate."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv saves a card of your week to your photos when you choose to."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv looks up who you want to call when you note 'call grandma'."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv adds an appointment from your note to your calendar."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniv transcribes your dictated notes and listens when you practise a language, on your iPhone itself."
          }
        }
      }
    }
  },
  "version": "1.0"
}